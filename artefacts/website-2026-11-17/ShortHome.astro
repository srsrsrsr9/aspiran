---
// Home page v4 (17 Nov 2026), from artefacts/marketing-review-2026-11-17.md in the app repo:
// - position: works on top of any coaching, YouTube teacher or books ("Your coaching teaches it. Aspiran makes it stay.");
// - lead with the pains people feel now (answers nobody checks, forgetting, prepping alone), not the method;
// - show the product (real demo screens in a phone) and a real marked answer (a sample answer we wrote, marked by
//   Aspiran's own marker on 17 Nov 2026, labelled "sample");
// - where it fits next to coaching and YouTube; price ₹3,999 a year, no founding offer (owner, 17 Nov 2026);
// - no "AI" labels anywhere (owner, 17 Nov 2026), and never a claim that a person marked anything.
// One action everywhere: "Try one topic free", the app's open demo (no account). English and Hindi side by side.
import BaseLayout from '../layouts/BaseLayout.astro';
import { waUrl } from '../i18n';
import '@fontsource/martel/latin-800.css';
// The Devanagari fonts load from src/pages/hi/index.astro only: on the English page even the ₹ sign would pull them.
import '../styles/short.css';

interface Props { lang?: 'en' | 'hi' }
const { lang = 'en' } = Astro.props;
const hi = lang === 'hi';
const T = (en: string, h: string) => (hi ? h : en);

const title = T('Aspiran: your coaching teaches it, Aspiran makes it stay', 'Aspiran: कोचिंग पढ़ाती है, Aspiran याद रखवाता है');
const description = T(
  'For UPSC aspirants, on top of any coaching or YouTube prep: what you studied comes back before you forget it, your Mains answers are marked in minutes, and a small pod keeps you company. English and Hindi. ₹3,999 a year, or free. Try one topic free.',
  'UPSC अभ्यर्थियों के लिए, किसी भी कोचिंग या YouTube की तैयारी के साथ: जो पढ़ा वह भूलने से पहले लौटता है, मेन्स के उत्तर मिनटों में जँचते हैं, और एक छोटा पॉड साथ रहता है। हिंदी और अंग्रेज़ी। ₹3,999 साल, या मुफ़्त। एक टॉपिक मुफ़्त आज़माइए।',
);
// Try buttons open Federalism's cover; Hindi pages ask for the Hindi demo.
const app = (where: string, hash = '#try/path-pol-federalism') => `https://app.aspiran.in/app/?utm_source=site&utm_medium=${where}${hi ? '&lang=hi' : ''}${hash}`;
const how = hi ? '/hi/how-it-works/' : '/how-it-works/';
const coaching = hi ? '/hi/for-coaching/' : '/for-coaching/';
const WA_PAY = waUrl(T("Hi Aspiran! I'd like to pay for Plus by UPI.", 'Hi Aspiran! मुझे UPI से Plus लेना है।'));
const tryLabel = T('Try one topic free', 'एक टॉपिक मुफ़्त आज़माइए');
const ticks = hi ? ['साइन-अप नहीं', 'कार्ड नहीं', '15 मिनट: संघवाद, असली PYQ के साथ'] : ['No sign-up', 'No card', '15 minutes: Federalism, with real past-paper questions'];

// What's in the app today, counted on production 15 Nov 2026 (2,063 questions, 257 videos, 11 papers; audio 20.4 h on 16 Nov), rounded down.
// Keep these the same as the demo's own lines (server/public/app/try.js libLine/joinLine).
const NUMS = hi
  ? ['2,000+ अभ्यास सवाल', '250+ छोटे वीडियो', '20+ घंटे के रिकॉर्ड किए नोट्स', '11 पिछले पेपर']
  : ['2,000+ practice questions', '250+ short videos', '20+ hours of recorded notes', '11 past papers'];

// Real screens from the open demo (captured 15 Nov 2026 at 375 px, app.aspiran.in), shown in the hero phone.
const shots = hi ? [
  ['/media/screens/1-guess-hi.webp', 'पढ़ने से पहले अंदाज़ा'],
  ['/media/screens/2-pyq-hi.webp', 'असली PYQ, "कितने पक्के हैं?"'],
  ['/media/screens/3-keep-hi.webp', 'जो सीखा, वह लौटकर आएगा'],
] : [
  ['/media/screens/1-guess.webp', 'Guess before you read'],
  ['/media/screens/2-pyq.webp', 'Real PYQs, "how sure?"'],
  ['/media/screens/3-keep.webp', 'What you learn comes back'],
];

// The pains, in the aspirant's words, each with what Aspiran does about it.
const pains = hi ? [
  ['"मेरे उत्तर कोई नहीं जाँचता।"', 'काग़ज़ पर लिखिए, फ़ोटो लीजिए। मिनटों में पाँच चीज़ों पर अंक: सवाल का निर्देश, ढाँचा, सामग्री, उदाहरण, निष्कर्ष, और हर एक के लिए एक ठोस सुधार। फिर सबसे कमज़ोर हिस्सा दोबारा लिखिए। हिंदी या अंग्रेज़ी में।', '#answer'],
  ['"अक्टूबर में पढ़ा, मार्च तक भूल गया।"', 'रोज़ 10 से 20 मिनट का रिव्यू। जो आपने पढ़ा, वह ठीक भूलने से पहले लौटता है: एक दिन, एक हफ़्ता, फिर महीने। आपकी किताबें, आपकी कोचिंग, आपका सिलेबस।', how + '#leak'],
  ['"मैं अकेले पढ़ रहा हूँ।"', 'पहले दिन से एक स्टडी रूम, और आपके स्टेज के अभ्यर्थियों का छोटा पॉड (8 तक), जैसे-जैसे लोग जुड़ते हैं। न रैंक, न दिखावा।', how + '#pod'],
] : [
  ['"Nobody checks my answers."', 'Write on paper, take a photo. In minutes you get marks on five things: what the question asked, structure, content, examples and the conclusion, each with one fix to make. Then rewrite the weakest part. In Hindi or English.', '#answer'],
  ['"I read it in October. It\'s gone by March."', 'A 10 to 20 minute review a day. What you studied comes back just before you\'d forget it: a day, a week, then months. Your books, your coaching, your syllabus.', how + '#leak'],
  ['"I\'m preparing alone."', 'A study room from day one, and a small pod (up to 8) of aspirants at your stage as people join. No ranks, no performing.', how + '#pod'],
];

// The sample answer: written by us as a typical first attempt, marked by Aspiran's marker on 17 Nov 2026 (150-word
// mode, typed). The marker's notes, trimmed for length; one example it gave (a report name) corrected to a real one (NeSDA). Question: UPSC CSE Mains 2025, GS2, Q7.
const sample = {
  q: T('e-governance projects have a built-in bias towards technology and back-end integration than user-centric designs. Examine.',
    'ई-गवर्नेंस परियोजनाओं में उपयोगकर्ता-केंद्रित डिज़ाइन के बजाय प्रौद्योगिकी और बैक-एंड एकीकरण की ओर एक अंतर्निहित झुकाव होता है। परीक्षण कीजिए।'),
  src: T('UPSC CSE Mains 2025 · GS2 · 10 marks, 150 words', 'UPSC CSE मेन्स 2025 · GS2 · 10 अंक, 150 शब्द'),
  answer: T(
    'E-governance means using ICT to deliver government services. India has launched many projects like Digital India, DigiLocker, UMANG and CoWIN. These projects have improved efficiency. Aadhaar-based DBT has reduced leakages… However, the focus is often on technology. Many portals are only in English and are hard to use on cheap phones. Biometric failures in ration shops have denied people their rations… In conclusion, e-governance should be citizen-centric for good governance.',
    'ई-गवर्नेंस का अर्थ है सरकारी सेवाएँ ICT से देना। भारत ने डिजिटल इंडिया, डिजीलॉकर, UMANG और CoWIN जैसी कई परियोजनाएँ शुरू की हैं। इनसे दक्षता बढ़ी है। आधार-आधारित DBT ने लीकेज घटाया है… लेकिन ज़ोर अक्सर तकनीक पर रहता है। कई पोर्टल सिर्फ़ अंग्रेज़ी में हैं और सस्ते फ़ोन पर चलाना कठिन है। राशन दुकानों पर बायोमेट्रिक विफलता से लोगों को राशन नहीं मिला… निष्कर्ष में, सुशासन के लिए ई-गवर्नेंस नागरिक-केंद्रित होना चाहिए।'),
  areas: hi ? [
    ['सवाल का निर्देश', 'झुकाव का ज़िक्र है, पर "परीक्षण" पूरा नहीं: तकनीक पर ज़ोर के कारण और उसके फ़ायदे-नुक़सान नहीं तौले गए।', 'तकनीक पर ज़ोर क्यों है (लागत, पैमाना), यह बताइए और निष्कर्ष से पहले दोनों पक्ष तौलिए।'],
    ['ढाँचा', 'परिचय, मुख्य भाग और निष्कर्ष हैं, पर उप-शीर्षक या बिंदु नहीं।', 'उप-शीर्षक जोड़िए: "तकनीक पहले", "उपयोगकर्ता की दिक़्क़तें", "सुझाव"।'],
    ['सामग्री', 'भाषा, फ़ोन और साक्षरता की बात है, पर बैक-एंड एकीकरण, डेटा सुरक्षा और संस्थागत सीमाएँ छूट गईं।', 'बैक-एंड इंटरऑपरेबिलिटी, डेटा प्राइवेसी और विभागों की क्षमता पर एक-एक बिंदु जोड़िए।'],
    ['उदाहरण', 'बड़ी योजनाओं और विफलताओं के नाम हैं, पर कोई आँकड़ा या आधिकारिक रिपोर्ट नहीं।', 'कोई ठोस आँकड़ा या आधिकारिक रिपोर्ट का हवाला दीजिए, जैसे e-गवर्नेंस सर्विस डिलीवरी असेसमेंट।'],
    ['निष्कर्ष', 'एक सामान्य "नागरिक-केंद्रित" पंक्ति; न सार, न आगे के क़दम।', 'मुख्य बातें समेटिए और ठोस क़दम सुझाइए: यूज़र-टेस्टिंग, कई भाषाओं में इंटरफ़ेस।'],
  ] : [
    ['What the question asked', 'Mentions the bias but doesn\'t fully examine why the tech-first approach exists or weigh its pros and cons.', 'Say why technology gets the focus (cost, scale) and weigh both sides before you conclude.'],
    ['Structure', 'A basic intro, body and conclusion, but no sub-headings or points.', 'Add sub-headings: "Technology first", "Gaps for users", "What to change".'],
    ['Content', 'Covers language, phones and literacy, but leaves out back-end integration, data security and institutional limits.', 'Add a point each on back-end interoperability, data privacy and the capacity of departments.'],
    ['Examples', 'Names big schemes and failures, but no data or official report.', 'Quote one figure or an official assessment, such as the e-Governance Service Delivery Assessment.'],
    ['Conclusion', 'A generic "citizen-centric" line, with no summing-up or next steps.', 'Sum up what you found and propose concrete steps: user testing, interfaces in many languages.'],
  ],
  verdict: T('At the level of a typical well-scoring answer on all five. To go above it: sharper analysis, sub-headings, one piece of data.',
    'पाँचों पर एक आम अच्छे अंक वाले उत्तर के बराबर। उससे ऊपर जाने के लिए: पैना विश्लेषण, उप-शीर्षक, एक आँकड़ा।'),
};

// Where Aspiran fits. Categories, not named brands. Fees: Delhi classroom GS courses list about ₹1.75 to 2.1 lakh a year (Nov 2026).
const fit = hi ? {
  cols: ['कोचिंग / ऑनलाइन कोर्स', 'YouTube और PDF', 'Aspiran'],
  rows: [
    ['नया टॉपिक पढ़ाना', 'हाँ', 'हाँ', 'नहीं, यह उनका काम है'],
    ['भूलने से पहले वापस लाना', 'कम ही', 'नहीं', 'हाँ, रोज़'],
    ['आपके उत्तर जाँचना', 'टेस्ट सीरीज़ में, अक्सर दिनों बाद', 'नहीं', 'मिनटों में, जितने आप लिखें*'],
    ['साथ पढ़ने वाले', 'बड़ा बैच', 'कमेंट सेक्शन', 'आपके स्टेज का छोटा पॉड'],
    ['हिंदी में', 'कहीं-कहीं', 'कहीं-कहीं', 'ज़्यादातर सब कुछ'],
    ['एक साल का ख़र्च', 'दिल्ली क्लासरूम: लगभग ₹1.75–2.1 लाख', '₹0', '₹0, या Plus ₹3,999'],
  ],
  foot: '* मुफ़्त में हफ़्ते में 3 उत्तर; Plus में असीमित।',
} : {
  cols: ['Coaching / online course', 'YouTube and PDFs', 'Aspiran'],
  rows: [
    ['Teaches a new topic', 'Yes', 'Yes', 'No, that\'s their job'],
    ['Brings it back before you forget', 'Rarely', 'No', 'Yes, daily'],
    ['Checks your answers', 'In test series, often days later', 'No', 'In minutes, as many as you write*'],
    ['People to prep with', 'A big batch', 'The comments', 'A small pod at your stage'],
    ['In Hindi', 'Some', 'Some', 'Most of it'],
    ['Cost for a year', 'Delhi classroom: about ₹1.75–2.1 lakh', '₹0', '₹0, or Plus at ₹3,999'],
  ],
  foot: '* 3 answers a week free; unlimited with Plus.',
};

const never = hi
  ? ['टूटने से डराने वाली स्ट्रीक', 'लीडरबोर्ड और पब्लिक रैंक', '"आपके चयन की संभावना: 73%"', '"सिर्फ़ 4 सीटें बचीं" वाली उलटी गिनती', 'पीछा करने वाली नोटिफ़िकेशन', 'कॉल सेंटर को बेचा गया आपका नंबर']
  : ['Streaks you are scared to break', 'Leaderboards and public ranks', '"Your selection chance: 73%"', '"Only 4 seats left" countdowns', 'Notifications that chase you', 'Your number sold to a call centre'];

const faq = hi ? [
  ['मैं पहले से कोचिंग जाता/जाती हूँ, या YouTube देखता/देखती हूँ। फिर यह क्यों?', 'कोचिंग एक बार पढ़ाती है। Aspiran उसे टिकाता है: जो आप पढ़ चुके हैं, उस पर रोज़ 10 से 20 मिनट का रिव्यू, और उत्तर लिखने का अभ्यास जिसकी जाँच मिनटों में हो। यह कोचिंग के साथ चलता है, उसकी जगह नहीं लेता।'],
  ['मेरे उत्तर कैसे जाँचे जाते हैं?', 'पहले आप ख़ुद, हर हिस्से पर। फिर Aspiran का मार्कर उसे UPSC के एक आम अच्छे अंक वाले उत्तर से मिलाता है और पाँच हिस्सों पर बताता है कि आप नीचे हैं, बराबर हैं या ऊपर, साथ में हर हिस्से का एक सुधार। यह ग़लत हो सकता है; इसीलिए पहले आप ख़ुद अंक देते हैं।'],
  ['क्या यह पूरा कोर्स है?', 'नहीं। आप अपनी किताबें या कोचिंग से पढ़ते हैं (लक्ष्मीकांत, NCERT, स्पेक्ट्रम)। Aspiran पक्का करता है कि पढ़ा हुआ याद रहे, उत्तर में काम आए, और आप अकेले न हों।'],
  ['यह Prelims के लिए है या Mains के लिए?', 'दोनों। Prelims: रोज़ का रिव्यू, असली PYQ, "कितने पक्के हैं?" से नेगेटिव मार्किंग की समझ, और मॉक। Mains: काग़ज़ पर उत्तर, ख़ुद जाँच, फिर Aspiran की जाँच, फिर दोबारा लिखना।'],
  ['क्या हिंदी में पूरा है?', 'ऐप, नोट्स, अभ्यास और उत्तर की जाँच हिंदी में हैं। वीडियो अभी अंग्रेज़ी में हैं।'],
  ['भुगतान कैसे करूँ?', 'ऐप में Plus खोलिए: UPI, कार्ड या नेट बैंकिंग। एक बार का भुगतान, अपने-आप रिन्यू नहीं, 7 दिन में रिफ़ंड।'],
  ['फ़ोन पर चलेगा?', 'हाँ। वेब ऐप किसी भी फ़ोन या लैपटॉप के ब्राउज़र में चलता है। Android ऐप Google Play पर टेस्टिंग में है।'],
] : [
  ['I already go to coaching, or watch YouTube. Why this too?', 'Coaching teaches it once. Aspiran makes it stay: a 10 to 20 minute review a day of what you have already studied, and answer writing that gets checked in minutes. It works alongside coaching, not instead of it.'],
  ['How are my answers marked?', 'By you first, part by part. Then Aspiran\'s marker compares it with a typical well-scoring UPSC answer and tells you, on five parts, whether you are below, at or above it, with one fix for each. It can be wrong, which is why you mark your own first.'],
  ['Is this a full course?', 'No. You learn from your own books or coaching (Laxmikanth, the NCERTs, Spectrum). Aspiran makes sure what you learn stays, works in an answer, and that you are not doing it alone.'],
  ['Is it for Prelims or Mains?', 'Both. Prelims: the daily review, real past questions, "how sure are you?" so negative marking stops surprising you, and mocks. Mains: answers on paper, marked by you first, then by Aspiran, then a rewrite.'],
  ['Is it really in Hindi?', 'The app, notes, practice and answer marking are in Hindi. The videos are in English for now.'],
  ['How do I pay?', 'Open Plus in the app: UPI, card or net banking. One payment, no auto-renewal, refund within 7 days.'],
  ['Does it work on my phone?', 'Yes. The web app runs in the browser on any phone or laptop. The Android app is in testing on Google Play.'],
];
---

<BaseLayout title={title} description={description} themeColor="#06070F" lang={lang}>
  <div class="sh" id="top">
    <a class="skip" href="#main">{T('Skip to the page', 'पेज पर जाएँ')}</a>
    <nav class="sh-nav" aria-label="Site">
      <a class="sh-brand" href={hi ? '/hi/' : '/'}>
        <svg aria-hidden="true" width="28" height="28" viewBox="0 0 40 40">
          <path d="M14 3c-2 3 2 4 0 7M20 2c-2 3 2 4 0 8M26 3c-2 3 2 4 0 7" fill="none" stroke="#F0A04B" stroke-width="2" stroke-linecap="round"></path>
          <path d="M5 15h30l-4.5 20.5a3 3 0 0 1-3 2.5H12.5a3 3 0 0 1-3-2.5z" fill="#C8693A"></path>
          <rect x="4" y="13" width="32" height="4.5" rx="2.2" fill="#E08A55"></rect>
        </svg>
        <b>Aspiran</b>
      </a>
      <div class="sh-nav-r">
        <a href={how}>{T('How it teaches', 'कैसे पढ़ाता है')}</a>
        <a href={coaching}>{T('For coaching centres', 'कोचिंग संस्थानों के लिए')}</a>
        {hi ? <a href="/" hreflang="en" lang="en">English</a> : <a class="sh-lang" href="/hi/" hreflang="hi" lang="hi">हिंदी</a>}
        <a class="sh-btn ghost sm" href={app('nav', '')} data-cta="app" data-where="nav">{T('Sign in', 'साइन इन')}</a>
      </div>
    </nav>

    <main id="main">
      <!-- 1. The position, the three pains, the one action, and the product itself. -->
      <header class="sh-hero v4">
        <div class="sh-hero-t">
          <p class="sh-kick">{T('FOR UPSC CSE · ENGLISH AND HINDI · WITH ANY COACHING', 'UPSC CSE के लिए · हिंदी और ENGLISH · किसी भी कोचिंग के साथ')}</p>
          <h1>{hi ? <>कोचिंग पढ़ाती है।<br /><span class="glow">Aspiran याद रखवाता है।</span></> : <>Your coaching teaches it.<br /><span class="glow">Aspiran makes it stay.</span></>}</h1>
