{
  // Top level = fully local: `npm run dev`. No Cloudflare account or login needed.
  // News drafting with Workers AI needs `npx wrangler login` first, then `npm run dev:ai`.
  // Deploying: `npx wrangler d1 create upsc-pods`, paste the real database_id into env.production,
  // then `npm run deploy`. Secrets go in with `npx wrangler secret put EDITOR_TOKEN --env production`.
  "name": "upsc-pods",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The web app (public/app/): same cards, practice, pods and checks as the phone. Installable as a desktop app.
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "POD", "class_name": "PodRoom" }, { "name": "COMMONS", "class_name": "CommonsRoom" }] },
  // v2: the Commons (presence-only study rooms).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PodRoom"] }, { "tag": "v2", "new_sqlite_classes": ["CommonsRoom"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "upsc-pods", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Content pack files. Locally this is simulated under .wrangler/ (no account needed).
  // Deploying: `npx wrangler r2 bucket create upsc-pods-media` and `... upsc-pods-backups` once. Backups are never served.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "upsc-pods-media" }, { "binding": "BACKUPS", "bucket_name": "upsc-pods-backups" }],
  "triggers": {
    // One half-hourly cron; index.ts runs what's due in IST: 05:30 fetch, merge and pod states; Mon 06:00 batch match;
    // 07:00 publish and the Chai post; Chotu's host schedule (Mon 08:00, Wed/Sat 19:00, Fri 20:00, Sun 18:00).
    "crons": ["0,30 * * * *"]
  },
  "env": {
    "production": {
      "account_id": "aec6050bcd4fc95113accdbaae8d14d3",
      "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
      "durable_objects": { "bindings": [{ "name": "POD", "class_name": "PodRoom" }, { "name": "COMMONS", "class_name": "CommonsRoom" }] },
      "d1_databases": [
        // Created on the Cloudflare dashboard, 12 Oct 2026.
        { "binding": "DB", "database_name": "upsc-pods", "database_id": "927b8d17-edf9-4ed3-b13e-a4940cd9452e" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "upsc-pods-media" }, { "binding": "BACKUPS", "bucket_name": "upsc-pods-backups" }],
      // Workers AI: public news only, never members' data.
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["0,30 * * * *"] },
      "observability": { "enabled": true },
      // Sign-in (auth-build.md). The Firebase project id is public (it is in every ID token), not a secret.
      // Sign-in is Google only. FIREBASE_PROJECT_ID is the Firebase project "upsc-pods". Until FIREBASE_WEB_API_KEY is set
      // the apps show sign-in as "unconfigured" and run without it (keep the sign_in_required flag off until tested).
      // SUPPORT_CONTACT is shown on the "access switched off" screen, e.g. an email address.
      // TODO(user): FIREBASE_WEB_API_KEY and FIREBASE_WEB_APP_ID come from Firebase console → Project settings → Your apps →
      // Add app → Web (public values that identify the project; the web app needs them to show "Continue with Google").
      // Payments (Cashfree): CASHFREE_ENV is "sandbox" or "production"; the keys are secrets (wrangler secret put CASHFREE_APP_ID /
      // CASHFREE_SECRET_KEY --env production), never here. PUBLIC_BASE_URL is where Cashfree sends people back after paying.
      // Password recovery email (src/mail.ts, Resend): `wrangler secret put RESEND_API_KEY --env production`, and MAIL_FROM
      // (e.g. "UPSC Pods <no-reply@your-domain>", a domain verified in Resend) as a var here or a secret. Without both,
      // "Forgot password?" isn't offered and staff reset passwords from Accounts as before. Reset links use PUBLIC_BASE_URL.
      "vars": { "FIREBASE_PROJECT_ID": "upsc-pods", "FIREBASE_WEB_API_KEY": "AIzaSyCmNFDhIdcTHUGsWbnChe2sQVdloVJaNgM", "FIREBASE_WEB_APP_ID": "1:751265224545:web:424c58c484db24a5f69720", "SUPPORT_CONTACT": "", "CASHFREE_ENV": "sandbox", "PUBLIC_BASE_URL": "https://app.aspiran.in",
        // PostHog project token for the public topic pages (learn.ts): write-only and public by design, not a secret.
        "POSTHOG_KEY": "phc_w8BUoc6nfx5UU7HFg2w5kZKTySWPBQKF6TbsQPPs8Sbx", "POSTHOG_HOST": "https://us.i.posthog.com" },
      // aspiran.in subdomains (DNS on Cloudflare since 12 Nov 2026). workers_dev stays on: released Android builds call the
      // workers.dev address, and naming routes would otherwise switch it off.
      "workers_dev": true,
      "routes": [{ "pattern": "app.aspiran.in", "custom_domain": true }, { "pattern": "admin.aspiran.in", "custom_domain": true }]
    }
  }
}
