{
  // Top level = fully local: `npm run dev`. No Cloudflare account or login needed.
  // News drafting with Workers AI needs `npx wrangler login` first, then `npm run dev:ai`.
  // Deploying: `npx wrangler d1 create upsc-pods`, paste the real database_id into env.production,
  // then `npm run deploy`. Secrets go in with `npx wrangler secret put EDITOR_TOKEN --env production`.
  "name": "upsc-pods",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // The web app (public/app/): same cards, practice, pods and checks as the phone. Installable as a desktop app.
  "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "POD", "class_name": "PodRoom" }, { "name": "COMMONS", "class_name": "CommonsRoom" }] },
  // v2: the Commons (presence-only study rooms).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PodRoom"] }, { "tag": "v2", "new_sqlite_classes": ["CommonsRoom"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "upsc-pods", "database_id": "00000000-0000-0000-0000-000000000000" }
  ],
  // Content pack files. Locally this is simulated under .wrangler/ (no account needed).
  // Deploying: `npx wrangler r2 bucket create upsc-pods-media` and `... upsc-pods-backups` once. Backups are never served.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "upsc-pods-media" }, { "binding": "BACKUPS", "bucket_name": "upsc-pods-backups" }],
  "triggers": {
    // One half-hourly cron; index.ts runs what's due in IST: 05:30 fetch, merge and pod states; Mon 06:00 batch match;
    // 07:00 publish and the Chai post; Chotu's host schedule (Mon 08:00, Tue/Thu 19:00, Fri 20:00, Sun 18:00).
    "crons": ["0,30 * * * *"]
  },
  "env": {
    "production": {
      "assets": { "directory": "./public", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
      "durable_objects": { "bindings": [{ "name": "POD", "class_name": "PodRoom" }, { "name": "COMMONS", "class_name": "CommonsRoom" }] },
      "d1_databases": [
        // Created on the Cloudflare dashboard, 12 Oct 2026.
        { "binding": "DB", "database_name": "upsc-pods", "database_id": "927b8d17-edf9-4ed3-b13e-a4940cd9452e" }
      ],
      "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "upsc-pods-media" }, { "binding": "BACKUPS", "bucket_name": "upsc-pods-backups" }],
      // Workers AI: public news only, never members' data.
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["0,30 * * * *"] },
      "observability": { "enabled": true }
    }
  }
}
