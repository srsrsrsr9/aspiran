{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/case-study@1",
  "title": "GS4 case study",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/case-study@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "question",
        "stakeholders",
        "issues",
        "options",
        "course",
        "values"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 130,
          "description": "The case, as the source gives it"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "What the member is asked to do"
        },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "who",
              "stake"
            ],
            "properties": {
              "who": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5
              },
              "stake": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 14,
                "description": "What they stand to gain or lose"
              }
            }
          },
          "minItems": 3,
          "maxItems": 6
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 16,
            "description": "One ethical issue in the case"
          },
          "minItems": 2,
          "maxItems": 5
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option",
              "merits",
              "demerits"
            ],
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 12
              },
              "merits": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 22
              },
              "demerits": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 22
              }
            }
          },
          "minItems": 3,
          "maxItems": 4
        },
        "course": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 60,
          "description": "A reasoned course of action, with the values behind it"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          },
          "minItems": 3,
          "maxItems": 6
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "question",
        "stakeholders",
        "issues",
        "options",
        "course",
        "values"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 176,
          "description": "The case, as the source gives it"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "What the member is asked to do"
        },
        "stakeholders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "who",
              "stake"
            ],
            "properties": {
              "who": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 7
              },
              "stake": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 19,
                "description": "What they stand to gain or lose"
              }
            }
          },
          "minItems": 3,
          "maxItems": 6
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 22,
            "description": "One ethical issue in the case"
          },
          "minItems": 2,
          "maxItems": 5
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "option",
              "merits",
              "demerits"
            ],
            "properties": {
              "option": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 17
              },
              "merits": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              },
              "demerits": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              }
            }
          },
          "minItems": 3,
          "maxItems": 4
        },
        "course": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 81,
          "description": "A reasoned course of action, with the values behind it"
        },
        "values": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 5
          },
          "minItems": 3,
          "maxItems": 6
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
