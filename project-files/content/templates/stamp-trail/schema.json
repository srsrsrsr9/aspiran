{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/stamp-trail@1",
  "title": "Stamp trail (process journey)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "item",
    "mood",
    "sfx",
    "stations",
    "takeaway",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/stamp-trail@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 2,
          "description": "What travels, e.g. 'Bill', 'FIR', 'Petition'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 3
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "stamp",
              "rule"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 4,
                "description": "Where the item is"
              },
              "stamp": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 2,
                "description": "The word on the stamp, e.g. 'Passed'"
              },
              "rule": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 28,
                "description": "What happens here, with the article or rule from the source"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "stamp",
              "rule"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 6,
                "description": "Where the item is"
              },
              "stamp": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 3,
                "description": "The word on the stamp, e.g. 'Passed'"
              },
              "rule": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 38,
                "description": "What happens here, with the article or rule from the source"
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 6
    },
    "takeaway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 24,
          "description": "An exception or twist worth remembering"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 33
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
