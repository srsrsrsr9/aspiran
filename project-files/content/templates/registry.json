  "engines": {
    "choose": {
      "title": "Choose",
      "sfx": "Tick on a pick, a santoor chime when right, a soft nudge (never a buzzer) when wrong.",
      "motion": "The picked option settles in 150 ms; the explanation rises in 200 ms."
    },
    "sort": {
      "title": "Sort into buckets",
      "sfx": "A whoosh as a card flies to its bucket, a snap when it lands, a nudge if it bounces back.",
      "motion": "Cards fly to the bucket in 300 ms; a wrong one bounces back with a 400 ms wobble."
    },
    "order": {
      "title": "Put in order",
      "sfx": "Tap to pick, a wooden snap as each tile locks, a chime when the line is complete.",
      "motion": "Tiles spring into slots (300 ms, slight overshoot); values count up as each locks."
    },
    "match": {
      "title": "Match pairs",
      "sfx": "Tick on a match, a nudge on a miss.",
      "motion": "Matched pairs slide together and fade to the done colour in 250 ms."
    },
    "reveal": {
      "title": "Flip and reveal",
      "sfx": "A page turn on each flip; a chime on the last card.",
      "motion": "Cards flip in 400 ms (a swap with reduced motion); lines on the back appear one by one."
    },
    "steps": {
      "title": "Step through",
      "sfx": "A page turn per beat; an optional soundscape under stories; a chime at the end.",
      "motion": "Each beat slides in from the right in 300 ms; choices fold open in 200 ms."
    },
    "compare": {
      "title": "Side by side",
      "sfx": "A tick as each row opens.",
      "motion": "Rows slide in from both sides and meet in the middle in 250 ms."
    },
    "hub": {
      "title": "Link web",
      "sfx": "A tick per spoke; a chime when all are open.",
      "motion": "Spokes draw out from the centre in 300 ms when tapped."
    },
    "cloze": {
      "title": "Fill the gap",
      "sfx": "A snap when a word drops into a gap, a nudge if it doesn't fit.",
      "motion": "Words fly into gaps in 250 ms; a wrong one shakes and returns."
    },
    "picture": {
      "title": "Picture story",
      "sfx": "A page turn per frame, a santoor chime on the frame that names the idea.",
      "motion": "The camera pans across one illustration to each frame's focus point in 1.3 s; with motion off, each frame is a still crop."
    }
  },
