{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/calm-script@1",
  "title": "Calm now (breathing and grounding)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "kind",
    "minutes",
    "pace",
    "support",
    "bed",
    "narrator",
    "audio",
    "beats",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/calm-script@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "kind": {
      "type": "string",
      "enum": [
        "slow-breath",
        "sigh",
        "grounding",
        "body-scan"
      ],
      "description": "slow-breath: about 6 breaths a minute. sigh: the double inhale and long exhale. grounding: 5-4-3-2-1. body-scan: attention moves through the body."
    },
    "minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "How long the whole script runs"
    },
    "pace": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "inhale",
        "hold",
        "exhale"
      ],
      "properties": {
        "inhale": {
          "type": "integer",
          "minimum": 2,
          "maximum": 6
        },
        "hold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "exhale": {
          "type": "integer",
          "minimum": 3,
          "maximum": 8
        }
      },
      "description": "Seconds per breath phase for slow-breath and sigh; null for grounding and body-scan"
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi",
        "verify"
      ],
      "properties": {
        "en": {
          "type": "string"
        },
        "hi": {
          "type": "string"
        },
        "verify": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "bed": {
      "type": "object",
      "description": "The optional sound under the voice: none by default",
      "x-from": "config"
    },
    "narrator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "hi": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-from": "config"
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": [
            "string",
            "null"
          ]
        },
        "hi": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "x-from": "config"
    },
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seconds",
          "en",
          "hi"
        ],
        "properties": {
          "seconds": {
            "type": "integer",
            "minimum": 3,
            "maximum": 90,
            "description": "How long this step lasts"
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "say"
            ],
            "properties": {
              "say": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 18,
                "description": "What the narrator says, in the second person"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "say"
            ],
            "properties": {
              "say": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 25,
                "description": "What the narrator says, in the second person"
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 14
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "close"
      ],
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26,
          "description": "What this is and how long it takes"
        },
        "close": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20,
          "description": "A gentle end, with no claim about what it did"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "close"
      ],
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "What this is and how long it takes"
        },
        "close": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27,
          "description": "A gentle end, with no claim about what it did"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
