{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/three-statements@1",
  "title": "Statement I, II and III",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "key",
    "optionText",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/three-statements@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "key": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "c",
        "d"
      ],
      "description": "a: II and III are both correct and both explain I. b: both correct but only one explains I. c: only one of II and III is correct, and it explains I. d: neither II nor III is correct."
    },
    "optionText": {
      "type": "object",
      "x-from": "config"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s1",
        "s2",
        "s3",
        "why"
      ],
      "properties": {
        "s1": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26,
          "description": "Statement I"
        },
        "s2": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26,
          "description": "Statement II"
        },
        "s3": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26,
          "description": "Statement III"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 44,
          "description": "Whether II and III are true, and whether each explains I"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "s1",
        "s2",
        "s3",
        "why"
      ],
      "properties": {
        "s1": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "Statement I"
        },
        "s2": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "Statement II"
        },
        "s3": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "Statement III"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 60,
          "description": "Whether II and III are true, and whether each explains I"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
