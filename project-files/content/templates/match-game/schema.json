{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/match-game@1",
  "title": "Match the pairs",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "roundSize",
    "rules",
    "pairs",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/match-game@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "roundSize": {
      "type": "integer",
      "x-from": "config"
    },
    "rules": {
      "type": "array",
      "x-from": "config"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "article",
          "en",
          "hi"
        ],
        "properties": {
          "article": {
            "type": "string",
            "maxLength": 6,
            "description": "The left item, e.g. an article number like 21 or 51A"
          },
          "en": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 8,
            "description": "What it is, 8 words or fewer"
          },
          "hi": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 11
          }
        }
      },
      "minItems": 6,
      "maxItems": 20
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
