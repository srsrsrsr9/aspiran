{
  "title": "Fill the gap",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "answers",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 7
      },
      "minItems": 2,
      "maxItems": 5,
      "description": "For each gap [[1]], [[2]] ... the index of the right word in bank"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "bank",
        "why"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 70,
          "description": "A paragraph with gaps marked [[1]], [[2]] and so on"
        },
        "bank": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          },
          "minItems": 3,
          "maxItems": 8
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "bank",
        "why"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 95,
          "description": "A paragraph with gaps marked [[1]], [[2]] and so on"
        },
        "bank": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 5
          },
          "minItems": 3,
          "maxItems": 8
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/fill-the-gap@1"
}
