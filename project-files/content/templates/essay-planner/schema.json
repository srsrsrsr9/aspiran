{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/essay-planner@1",
  "title": "Essay planner",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "kind",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/essay-planner@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "kind": {
      "type": "string",
      "enum": [
        "philosophical",
        "issue-based"
      ]
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "reading",
        "dimensions",
        "opening",
        "counter",
        "close"
      ],
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20,
          "description": "The essay topic, as the source gives it"
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "What the topic is really asking, and the trap of a narrow reading"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lens",
              "point"
            ],
            "properties": {
              "lens": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 3,
                "description": "e.g. Social, Economic, Ethical"
              },
              "point": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 22,
                "description": "One point from that lens, from the source"
              }
            }
          },
          "minItems": 4,
          "maxItems": 8
        },
        "opening": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 32,
          "description": "An opening idea: a story, example or image from the source"
        },
        "counter": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "The strongest counter-view, put fairly"
        },
        "close": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "A way to end that returns to the theme"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "theme",
        "reading",
        "dimensions",
        "opening",
        "counter",
        "close"
      ],
      "properties": {
        "theme": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27,
          "description": "The essay topic, as the source gives it"
        },
        "reading": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 49,
          "description": "What the topic is really asking, and the trap of a narrow reading"
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lens",
              "point"
            ],
            "properties": {
              "lens": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5,
                "description": "e.g. Social, Economic, Ethical"
              },
              "point": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30,
                "description": "One point from that lens, from the source"
              }
            }
          },
          "minItems": 4,
          "maxItems": 8
        },
        "opening": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 44,
          "description": "An opening idea: a story, example or image from the source"
        },
        "counter": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "The strongest counter-view, put fairly"
        },
        "close": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "A way to end that returns to the theme"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
