            "label"
          ],
          "properties": {
            "label": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "en",
                "hi"
              ],
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 3,
                  "description": "Who acts first, e.g. 'State legislature'"
                },
                "hi": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 5
                }
              }
            }
          }
        },
        "governor": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "en",
                "hi"
