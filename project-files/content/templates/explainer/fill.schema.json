          "type": "object",
          "additionalProperties": false,
          "required": [
            "label"
          ],
          "properties": {
            "label": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "en",
                "hi"
              ],
              "properties": {
                "en": {
                  "type": "string",
                  "minLength": 1,
