    "linkedFromChips",
    "tone",
    "elements",
    "scenes"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "staticLink": {
      "type": "string",
      "minLength": 1,
      "x-maxWords": 4,
      "description": "The static anchor, e.g. 'Article 200'"
    },
    "linkedFromChips": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "x-maxWords": 3
      },
      "minItems": 1,
      "maxItems": 3
