{
  "title": "Fact or opinion?",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "items",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "en",
          "hi"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "fact",
              "opinion"
            ]
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "why"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 20
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 16
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "why"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 27
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 22
              }
            }
          }
        }
      },
      "minItems": 4,
      "maxItems": 8
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/fact-or-opinion@1"
}
