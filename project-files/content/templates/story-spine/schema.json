{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/story-spine@1",
  "title": "Story spine (Essay and GS4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "paper",
    "spineOpeners",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/story-spine@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "paper": {
      "type": "string",
      "enum": [
        "Essay",
        "GS4"
      ]
    },
    "spineOpeners": {
      "type": "object",
      "x-from": "config"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "news",
        "spine",
        "why",
        "topic",
        "starter"
      ],
      "properties": {
        "news": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 34,
          "description": "The news item in one or two plain sentences, from the source"
        },
        "spine": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 26,
            "description": "One line of the spine, starting with its opener"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "Why a story opening works for this kind of essay"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "An essay topic for the member to try the spine on"
        },
        "starter": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 14,
          "description": "A nudge for the member's first line, not an answer"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "news",
        "spine",
        "why",
        "topic",
        "starter"
      ],
      "properties": {
        "news": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 46,
          "description": "The news item in one or two plain sentences, from the source"
        },
        "spine": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 36,
            "description": "One line of the spine, starting with its opener"
          },
          "minItems": 5,
          "maxItems": 5
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "Why a story opening works for this kind of essay"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22,
          "description": "An essay topic for the member to try the spine on"
        },
        "starter": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 19,
          "description": "A nudge for the member's first line, not an answer"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
