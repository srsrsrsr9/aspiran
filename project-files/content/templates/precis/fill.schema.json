{
  "title": "Précis (qualifying paper)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "language",
    "passage",
    "precisTitle",
    "precis",
    "steps",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "hi"
      ],
      "description": "The language of the passage: en for Paper B, hi for Paper A in Hindi"
    },
    "passage": {
      "type": "string",
      "minLength": 1,
      "x-maxWords": 450,
      "description": "Copied exactly from the source"
    },
    "precisTitle": {
      "type": "string",
      "minLength": 1,
      "x-maxWords": 8,
      "description": "A title for the précis, in the passage's language"
    },
    "precis": {
      "type": "string",
      "minLength": 1,
      "x-maxWords": 160,
      "description": "About one-third of the passage, in your own words, in the passage's language"
    },
    "steps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 60,
          "description": "How the précis was made: what was kept, what was cut, and why"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 81
        }
      }
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tip"
      ],
      "properties": {
        "tip": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20,
          "description": "One tip for the member's own précis"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tip"
      ],
      "properties": {
        "tip": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27,
          "description": "One tip for the member's own précis"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/precis@1"
}
