{
  "title": "Spot the better answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "kind",
    "pairs",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "introduction",
        "conclusion",
        "body point"
      ],
      "description": "Which part of a Mains answer the pairs show"
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "better",
          "en",
          "hi"
        ],
        "properties": {
          "better": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1,
            "description": "0 if A is better, 1 if B"
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "a",
              "b",
              "why"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 20
              },
              "a": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 60,
                "description": "Answer A"
              },
              "b": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 60,
                "description": "Answer B"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 26,
                "description": "What makes the better one better"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "a",
              "b",
              "why"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 27
              },
              "a": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 81,
                "description": "Answer A"
              },
              "b": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 81,
                "description": "Answer B"
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 36,
                "description": "What makes the better one better"
              }
            }
          }
        }
      },
      "minItems": 2,
      "maxItems": 6
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/better-answer@1"
}
