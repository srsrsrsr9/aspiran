{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/thinker-lens@1",
  "title": "Thinker lens (GS4 and Essay)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "quoteId",
    "quote",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/thinker-lens@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "quoteId": {
      "type": "string",
      "x-enumFromConfig": "quoteIds",
      "description": "Id of the thinker's line in the quote bank. The app inserts the exact words, the citation and the original script; never write the quote yourself."
    },
    "quote": {
      "type": "object",
      "description": "Copied from content/quotes/quotes.json at assembly time",
      "x-from": "config"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thinker",
        "topic",
        "meaning",
        "useIt",
        "introLine",
        "syllabus"
      ],
      "properties": {
        "thinker": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8,
          "description": "Who: name and one identifying phrase, from the source"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8,
          "description": "The GS4 or Essay theme this line serves"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "What the line means, in plain words"
        },
        "useIt": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 32,
          "description": "How to use it in an answer, with the kind of question it fits"
        },
        "introLine": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 28,
          "description": "A sample opening or closing sentence for an answer that uses the idea. Credit the thinker; do not repeat the quote"
        },
        "syllabus": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20,
          "description": "Where it sits in the syllabus"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thinker",
        "topic",
        "meaning",
        "useIt",
        "introLine",
        "syllabus"
      ],
      "properties": {
        "thinker": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11,
          "description": "Who: name and one identifying phrase, from the source"
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11,
          "description": "The GS4 or Essay theme this line serves"
        },
        "meaning": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "What the line means, in plain words"
        },
        "useIt": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 44,
          "description": "How to use it in an answer, with the kind of question it fits"
        },
        "introLine": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 38,
          "description": "A sample opening or closing sentence for an answer that uses the idea. Credit the thinker; do not repeat the quote"
        },
        "syllabus": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27,
          "description": "Where it sits in the syllabus"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
