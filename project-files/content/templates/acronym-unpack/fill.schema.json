{
  "title": "Acronym unpacker",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "acronym",
    "letters",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "acronym": {
      "type": "string",
      "maxLength": 16,
      "description": "The acronym itself, e.g. MGNREGA"
    },
    "letters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "letter",
              "word"
            ],
            "properties": {
              "letter": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 1
              },
              "word": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 3
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "letter",
              "word"
            ],
            "properties": {
              "letter": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 2
              },
              "word": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5
              }
            }
          }
        }
      },
      "minItems": 2,
      "maxItems": 12
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "fact"
      ],
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "what",
        "fact"
      ],
      "properties": {
        "what": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        },
        "fact": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/acronym-unpack@1"
}
