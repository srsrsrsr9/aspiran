{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/data-interpretation@1",
  "title": "Data interpretation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "table",
    "questions",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/data-interpretation@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "columns",
        "rows"
      ],
      "properties": {
        "unit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "hi"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 6,
              "description": "Unit for the values"
            },
            "hi": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 9
            }
          }
        },
        "columns": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "hi"
          ],
          "properties": {
            "en": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 4
              },
              "minItems": 1,
              "maxItems": 4
            },
            "hi": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 6
              },
              "minItems": 1,
              "maxItems": 4
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "values",
              "en",
              "hi"
            ],
            "properties": {
              "values": {
                "type": "array",
                "items": {
                  "type": "number"
                },
                "minItems": 1,
                "maxItems": 4
              },
              "en": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "x-maxWords": 4
                  }
                }
              },
              "hi": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "x-maxWords": 6
                  }
                }
              }
            }
          },
          "minItems": 3,
          "maxItems": 8
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answer",
          "answerExpr",
          "en",
          "hi"
        ],
        "properties": {
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "answerExpr": {
            "type": "string",
            "pattern": "^[0-9+\\-*/(). ]+$",
            "description": "The arithmetic that gives the right option's value, using only digits and + - * / ( ). The validator works it out and checks it against the option."
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "steps"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 6
                },
                "minItems": 4,
                "maxItems": 4
              },
              "steps": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "steps"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 41
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 9
                },
                "minItems": 4,
                "maxItems": 4
              },
              "steps": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 41
              }
            }
          }
        }
      },
      "minItems": 2,
      "maxItems": 4
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
