{
  "title": "Then and now slider",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "from",
    "to",
    "metrics",
    "takeaway",
    "note",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year"
      ],
      "properties": {
        "year": {
          "type": "integer"
        }
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "year"
      ],
      "properties": {
        "year": {
          "type": "integer"
        }
      }
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi",
          "from",
          "to"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "unit"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 4
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 3
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "unit"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 6
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5
              }
            }
          },
          "from": {
            "type": "number"
          },
          "to": {
            "type": "number"
          }
        }
      },
      "minItems": 1,
      "maxItems": 3
    },
    "takeaway": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20,
          "description": "Any change in how the number was measured, or a short dash if none"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27
        }
      },
      "description": "Method caveat"
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/then-now@1"
}
