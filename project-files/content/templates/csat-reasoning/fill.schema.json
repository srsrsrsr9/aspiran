{
  "title": "Logical reasoning (CSAT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "problems",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "topic",
          "answer",
          "en",
          "hi"
        ],
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "direction-sense",
              "blood-relation",
              "syllogism",
              "arrangement",
              "coding",
              "series"
            ]
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "steps"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 60
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 10
                },
                "minItems": 4,
                "maxItems": 4
              },
              "steps": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 44,
                "description": "How to reach the answer, step by step"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "steps"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 81
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 14
                },
                "minItems": 4,
                "maxItems": 4
              },
              "steps": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 60,
                "description": "How to reach the answer, step by step"
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 5
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/csat-reasoning@1"
}
