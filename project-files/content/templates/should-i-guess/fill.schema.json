{
  "title": "Should I guess? (negative marking)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "rounds",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "optionsLeft",
          "en",
          "hi"
        ],
        "properties": {
          "optionsLeft": {
            "type": "integer",
            "minimum": 2,
            "maximum": 4,
            "description": "How many options are still possible after the member's own elimination"
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "situation"
            ],
            "properties": {
              "situation": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 26,
                "description": "What the member knows about this question, in the second person"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "situation"
            ],
            "properties": {
              "situation": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 36,
                "description": "What the member knows about this question, in the second person"
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 4
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26,
          "description": "The rule of thumb in one line"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "The rule of thumb in one line"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/should-i-guess@1"
}
