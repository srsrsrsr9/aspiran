{
  "title": "Draw it in the answer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "paper",
    "diagram",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "paper": {
      "type": "string",
      "enum": [
        "GS1",
        "GS2",
        "GS3"
      ]
    },
    "diagram": {
      "type": "string",
      "enum": [
        "flowchart",
        "cycle",
        "hub",
        "timeline"
      ],
      "description": "The shape to sketch"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "nodes",
        "caption",
        "why"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "A Mains-style question the diagram helps answer"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 7,
            "description": "One box of the diagram"
          },
          "minItems": 3,
          "maxItems": 8
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 14,
          "description": "A one-line caption under the diagram"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "Why a diagram helps here and where to put it in the answer"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "nodes",
        "caption",
        "why"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "A Mains-style question the diagram helps answer"
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 10,
            "description": "One box of the diagram"
          },
          "minItems": 3,
          "maxItems": 8
        },
        "caption": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 19,
          "description": "A one-line caption under the diagram"
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "Why a diagram helps here and where to put it in the answer"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/answer-diagram@1"
}
