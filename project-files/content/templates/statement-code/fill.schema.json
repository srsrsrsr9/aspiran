{
  "title": "Statements with codes",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "kind",
    "truth",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "kind": {
      "type": "string",
      "enum": [
        "statements",
        "items"
      ],
      "description": "statements: judge each statement. items: pick the items that fit the stem."
    },
    "truth": {
      "type": "array",
      "items": {
        "type": "boolean"
      },
      "minItems": 2,
      "maxItems": 4,
      "description": "For each statement or item, in order: true if it is correct or fits"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stem",
        "statements",
        "why"
      ],
      "properties": {
        "stem": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 24,
          "description": "The question stem, e.g. 'With reference to the Fundamental Duties, consider the following statements:'"
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 26
          },
          "minItems": 2,
          "maxItems": 4
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 44,
          "description": "Which are right and which are wrong, and why"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stem",
        "statements",
        "why"
      ],
      "properties": {
        "stem": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 33,
          "description": "The question stem, e.g. 'With reference to the Fundamental Duties, consider the following statements:'"
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 36
          },
          "minItems": 2,
          "maxItems": 4
        },
        "why": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 60,
          "description": "Which are right and which are wrong, and why"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/statement-code@1"
}
