{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/scheme-snapshot@1",
  "title": "Scheme snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "launched",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/scheme-snapshot@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "launched": {
      "type": [
        "integer",
        "null"
      ]
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ministry",
        "aim",
        "who",
        "keyNumber",
        "examAngle"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "ministry": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "aim": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 18
        },
        "keyNumber": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "The one number to remember, with its unit"
        },
        "examAngle": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ministry",
        "aim",
        "who",
        "keyNumber",
        "examAngle"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        },
        "ministry": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        },
        "aim": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 25
        },
        "keyNumber": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22,
          "description": "The one number to remember, with its unit"
        },
        "examAngle": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
