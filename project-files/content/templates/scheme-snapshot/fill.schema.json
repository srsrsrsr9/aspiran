          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "ministry": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "aim": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 18
        },
        "keyNumber": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "The one number to remember, with its unit"
        },
        "examAngle": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ministry",
        "aim",
        "who",
        "keyNumber",
        "examAngle"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        },
        "ministry": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        },
        "aim": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        },
        "who": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 25
        },
        "keyNumber": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22,
          "description": "The one number to remember, with its unit"
        },
        "examAngle": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27
        }
      }
    },
