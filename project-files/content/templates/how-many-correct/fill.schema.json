{
  "title": "How many of the above?",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "items",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "truth",
          "en",
          "hi"
        ],
        "properties": {
          "truth": {
            "type": "array",
            "items": {
              "type": "boolean"
            },
            "minItems": 2,
            "maxItems": 4,
            "description": "true or false for each statement, in order"
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stem",
              "statements",
              "why"
            ],
            "properties": {
              "stem": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 16
              },
              "statements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 26
                },
                "minItems": 2,
                "maxItems": 4
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 42,
                "description": "Which statements are wrong and why"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stem",
              "statements",
              "why"
            ],
            "properties": {
              "stem": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 22
              },
              "statements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 36
                },
                "minItems": 2,
                "maxItems": 4
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 57,
                "description": "Which statements are wrong and why"
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 4
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/how-many-correct@1"
}
