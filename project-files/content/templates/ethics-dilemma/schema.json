{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/ethics-dilemma@1",
  "title": "Ethics dilemma (GS4)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "en",
    "hi",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/ethics-dilemma@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "question",
        "options",
        "reflect"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 80
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "outcome",
              "values"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 10
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              },
              "values": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 8,
                "description": "The values this choice serves or sacrifices"
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "reflect": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 26,
          "description": "A question to sit with, not an answer"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario",
        "question",
        "options",
        "reflect"
      ],
      "properties": {
        "scenario": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 108
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "outcome",
              "values"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 14
              },
              "outcome": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 41
              },
              "values": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 11,
                "description": "The values this choice serves or sacrifices"
              }
            }
          },
          "minItems": 3,
          "maxItems": 3
        },
        "reflect": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36,
          "description": "A question to sit with, not an answer"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
