{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/mock-paper@1",
  "title": "Mock paper (sectional, Prelims)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "tone",
    "title",
    "mood",
    "sfx",
    "paper",
    "section",
    "marking",
    "timer",
    "questions",
    "sources",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/mock-paper@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mood": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bed",
        "sfx",
        "motion"
      ],
      "properties": {
        "bed": {
          "type": [
            "string",
            "null"
          ]
        },
        "sfx": {
          "type": "boolean"
        },
        "motion": {
          "type": "string",
          "enum": [
            "gentle",
            "crisp",
            "none"
          ]
        }
      },
      "x-from": "config"
    },
    "sfx": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "x-from": "config"
    },
    "paper": {
      "type": "string",
      "enum": [
        "prelims-gs1"
      ],
      "description": "The paper this mock imitates"
    },
    "section": {
      "type": "string",
      "description": "The syllabus area, for example \"GS2 Polity\""
    },
    "marking": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "right",
        "wrong",
        "blank"
      ],
      "properties": {
        "right": {
          "type": "number"
        },
        "wrong": {
          "type": "number"
        },
        "blank": {
          "type": "number"
        }
      },
      "x-from": "config"
    },
    "timer": {
      "type": "object",
      "description": "Off by default. When on, it counts time used upward; there is never a countdown",
      "x-from": "config"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "format",
          "node",
          "answer",
          "difficulty",
          "en",
          "hi"
        ],
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "direct",
              "negative",
              "statement-code",
              "select-items",
              "how-many-statements",
              "how-many-pairs",
              "statement-i-ii",
              "statement-i-ii-iii",
              "list-match"
            ],
            "description": "The Prelims format this question uses (see templates/exam-formats.json)"
          },
          "node": {
            "type": "string",
            "x-enumFromConfig": "nodes",
            "description": "Id of the syllabus-map node this question tests (from the config's node list)"
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Index of the right option, 0 for (a) to 3 for (d), the same in both languages"
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stem",
              "statements",
              "ask",
              "options",
              "why"
            ],
            "properties": {
              "stem": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 45,
                "description": "The question as it appears, before any statements or lists"
              },
              "statements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 30,
                  "description": "One numbered statement, pair or list item, without its number"
                },
                "minItems": 0,
                "maxItems": 8
              },
              "ask": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "x-maxWords": 22,
                "description": "The closing line, for example \"Which of the statements given above is/are correct?\". null for a direct or negative question"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 16,
                  "description": "One option, without its letter"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 45,
                "description": "Why the right option is right and the most tempting wrong one is wrong, from the source"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "stem",
              "statements",
              "ask",
              "options",
              "why"
            ],
            "properties": {
              "stem": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 61,
                "description": "The question as it appears, before any statements or lists"
              },
              "statements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 41,
                  "description": "One numbered statement, pair or list item, without its number"
                },
                "minItems": 0,
                "maxItems": 8
              },
              "ask": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "x-maxWords": 30,
                "description": "The closing line, for example \"Which of the statements given above is/are correct?\". null for a direct or negative question"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 22,
                  "description": "One option, without its letter"
                },
                "minItems": 4,
                "maxItems": 4
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 61,
                "description": "Why the right option is right and the most tempting wrong one is wrong, from the source"
              }
            }
          }
        }
      },
      "minItems": 10,
      "maxItems": 100
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
