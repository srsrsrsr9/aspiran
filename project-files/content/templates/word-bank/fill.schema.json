{
  "title": "Shabd: bilingual terms",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "words",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "meaning",
              "example"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 4
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 18
              },
              "example": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 20,
                "description": "A sentence using the term"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "term",
              "meaning",
              "example"
            ],
            "properties": {
              "term": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 6
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 25
              },
              "example": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 27,
                "description": "A sentence using the term"
              }
            }
          }
        }
      },
      "minItems": 4,
      "maxItems": 8
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/word-bank@1"
}
