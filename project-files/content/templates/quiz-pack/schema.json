{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "upsc-pods/quiz-pack@1",
  "title": "Quiz night",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "for",
    "questions",
    "review"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "upsc-pods/quiz-pack@1",
      "x-from": "config"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "for": {
      "type": "string",
      "x-from": "config"
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "answerIndex",
              "explanation"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 8
                },
                "minItems": 4,
                "maxItems": 4
              },
              "answerIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 25
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "answerIndex",
              "explanation"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 41
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 11
                },
                "minItems": 4,
                "maxItems": 4
              },
              "answerIndex": {
                "type": "integer",
                "minimum": 0,
                "maximum": 3
              },
              "explanation": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 34
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 10
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "approved-en",
            "approved-hi",
            "approved"
          ]
        },
        "checkedBy": {
          "type": [
            "string",
            "null"
          ]
        },
        "checkedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "x-from": "config"
    },
    "tags": {
      "type": "object",
      "x-from": "config",
      "description": "Exam tags from the template: stage, papers and question formats (see templates/exam-formats.json)"
    },
    "provenance": {
      "type": "object",
      "x-from": "config",
      "description": "Added by the generator: model, template, date. Absent on hand-written packs."
    }
  }
}
