{
  "title": "Chai stall radio",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "desk",
    "stations",
    "signoff",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 6
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 9
        }
      }
    },
    "desk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 4,
          "description": "The show's name, e.g. 'Monsoon desk'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 6
        }
      }
    },
    "stations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "callsign",
              "lines"
            ],
            "properties": {
              "callsign": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 3,
                "description": "The segment's name"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 16
                },
                "minItems": 2,
                "maxItems": 3
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "callsign",
              "lines"
            ],
            "properties": {
              "callsign": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5,
                "description": "The segment's name"
              },
              "lines": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 22
                },
                "minItems": 2,
                "maxItems": 3
              }
            }
          }
        }
      },
      "minItems": 2,
      "maxItems": 4
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 12
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 17
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/radio@1"
}
