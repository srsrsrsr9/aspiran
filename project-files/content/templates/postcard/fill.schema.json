{
  "title": "Postcard from a place",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "place",
    "greeting",
    "stamp",
    "scape",
    "facts",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 4
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 6
        }
      }
    },
    "greeting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 12,
          "description": "Front of the card, e.g. 'Greetings from the world's largest mangrove forest'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 17
        }
      }
    },
    "stamp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 2,
          "description": "One word on the stamp"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 3
        }
      }
    },
    "scape": {
      "type": "string",
      "enum": [
        "waves",
        "rain",
        "wind",
        "market",
        "forest"
      ],
      "description": "The soundscape that suits the place"
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 20,
            "description": "Three facts written like a postcard to a friend"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "hi": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 27
          },
          "minItems": 3,
          "maxItems": 3
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/postcard@1"
}
