{
  "title": "Narrated classic (two minutes)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "passage",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 300,
          "description": "Copied exactly from the public-domain text in the source. No edits, no cuts inside a sentence."
        },
        "hi": {
          "type": [
            "string",
            "null"
          ],
          "description": "Leave null. The Hindi editor translates the passage."
        }
      }
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "listenFor",
        "after"
      ],
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "Who wrote it, when, and why it is worth two minutes"
        },
        "listenFor": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 18,
          "description": "One thing to listen for"
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22,
          "description": "One question to think about afterwards, about the member's own preparation"
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intro",
        "listenFor",
        "after"
      ],
      "properties": {
        "intro": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41,
          "description": "Who wrote it, when, and why it is worth two minutes"
        },
        "listenFor": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 25,
          "description": "One thing to listen for"
        },
        "after": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30,
          "description": "One question to think about afterwards, about the member's own preparation"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/narrated-classic@1"
}
