{
  "title": "Mnemonic card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "mnemonic",
    "for",
    "letters",
    "note",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "mnemonic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 10,
          "description": "The memory phrase"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 14
        }
      }
    },
    "for": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 10,
          "description": "What it helps you remember"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 14
        }
      }
    },
    "letters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "stands"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 2
              },
              "stands": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 6
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "stands"
            ],
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 3
              },
              "stands": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 9
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 10
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 27
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/mnemonic@1"
}
