{
  "title": "Answer skeleton",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "paper",
    "en",
    "hi",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "paper": {
      "type": "string",
      "enum": [
        "GS1",
        "GS2",
        "GS3",
        "GS4",
        "Essay"
      ]
    },
    "en": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "directive",
        "intro",
        "body",
        "conclusion",
        "keywords"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30
        },
        "directive": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 3,
          "description": "The directive word in the question"
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 40
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 22
          },
          "minItems": 3,
          "maxItems": 5
        },
        "conclusion": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 36
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          },
          "minItems": 3,
          "maxItems": 6
        }
      }
    },
    "hi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "directive",
        "intro",
        "body",
        "conclusion",
        "keywords"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41
        },
        "directive": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 5,
          "description": "The directive word in the question"
        },
        "intro": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 54
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 30
          },
          "minItems": 3,
          "maxItems": 5
        },
        "conclusion": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 49
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 5
          },
          "minItems": 3,
          "maxItems": 6
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/answer-skeleton@1"
}
