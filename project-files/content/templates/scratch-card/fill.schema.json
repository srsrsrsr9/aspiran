{
  "title": "Scratch and reveal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "cards",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 6
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 9
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tease",
              "answer",
              "detail"
            ],
            "properties": {
              "tease": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 14,
                "description": "A question the member answers in their head before scratching"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 8,
                "description": "The answer, short enough to read at a glance"
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30,
                "description": "Why, with one fact from the source"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tease",
              "answer",
              "detail"
            ],
            "properties": {
              "tease": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 19,
                "description": "A question the member answers in their head before scratching"
              },
              "answer": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 11,
                "description": "The answer, short enough to read at a glance"
              },
              "detail": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 41,
                "description": "Why, with one fact from the source"
              }
            }
          }
        }
      },
      "minItems": 1,
      "maxItems": 3
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/scratch-card@1"
}
