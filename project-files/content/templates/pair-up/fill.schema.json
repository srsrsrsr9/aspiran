{
  "title": "Pair up",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "heads",
    "pairs",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "heads": {
      "en": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left",
          "right"
        ],
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 3
          }
        }
      },
      "hi": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "left",
          "right"
        ],
        "properties": {
          "left": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 5
          },
          "right": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 5
          }
        }
      }
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5
              },
              "right": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 8
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "left",
              "right"
            ],
            "properties": {
              "left": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 7
              },
              "right": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 11
              }
            }
          }
        }
      },
      "minItems": 4,
      "maxItems": 10
    },
    "memoryHook": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 18
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 25
        }
      },
      "description": "Optional. An acronym, image or tiny story that helps recall the list. Write the Hindi hook natively in Hindi; it does not have to match the English. null if none fits."
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/pair-up@1"
}
