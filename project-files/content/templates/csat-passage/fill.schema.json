{
  "title": "Reading comprehension (CSAT)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "passage",
    "questions",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug, e.g. article-200"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ],
      "description": "LIGHT: everyday or quirky. NEUTRAL: most policy and static topics. SERIOUS: security, disasters, health crises. TRAGIC: loss of life."
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "passage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 320,
          "description": "Copied exactly from the source passage"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 432,
          "description": "A faithful Hindi translation of the passage; the editor checks it"
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "answer",
          "en",
          "hi"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "main-idea",
              "inference",
              "assumption",
              "corollary",
              "tone"
            ],
            "description": "What the question tests"
          },
          "answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "en": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "why"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 22
                },
                "minItems": 4,
                "maxItems": 4
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 36,
                "description": "Why the answer follows from the passage, and why the trap option does not"
              }
            }
          },
          "hi": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "question",
              "options",
              "why"
            ],
            "properties": {
              "question": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 41
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "x-maxWords": 30
                },
                "minItems": 4,
                "maxItems": 4
              },
              "why": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 49,
                "description": "Why the answer follows from the passage, and why the trap option does not"
              }
            }
          }
        }
      },
      "minItems": 2,
      "maxItems": 4
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 16,
          "description": "Where the facts come from, e.g. 'Census of India 2011'"
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 22
        }
      },
      "description": "Name the source documents. Never invent a source."
    }
  },
  "x-type": "upsc-pods/csat-passage@1"
}
