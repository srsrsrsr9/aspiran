        "properties": {
          "what": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "hi"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 14
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 19
              }
            }
