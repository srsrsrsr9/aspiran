          "type": "string",
          "minLength": 1,
          "x-maxWords": 6,
          "description": "e.g. '4 to 5 of 10'"
        },
        "caveat": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "hi"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 20
            },
            "hi": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 28
            }
          },
          "description": "Always say this is a practice estimate, not a UPSC prediction"
