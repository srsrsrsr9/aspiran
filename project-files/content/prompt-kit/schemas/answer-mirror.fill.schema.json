{
  "title": "Answer Mirror (feedback on the member's own answer)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "demand",
    "keepThis",
    "rubric",
    "fixes",
    "missing",
    "betterIntro",
    "betterConclusion",
    "diagramIdea",
    "practiceBand"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "directive",
        "parts"
      ],
      "properties": {
        "directive": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "hi"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 4
            },
            "hi": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 6
            }
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "part",
              "covered"
            ],
            "properties": {
              "part": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "en",
                  "hi"
                ],
                "properties": {
                  "en": {
                    "type": "string",
                    "minLength": 1,
                    "x-maxWords": 12
                  },
                  "hi": {
                    "type": "string",
                    "minLength": 1,
                    "x-maxWords": 16
                  }
                }
              },
              "covered": {
                "type": "string",
                "enum": [
                  "yes",
                  "partly",
                  "no"
                ]
              }
            }
          },
          "minItems": 1,
          "maxItems": 5
        }
      }
    },
    "keepThis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 30
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 41
        }
      },
      "description": "What already works. Always first, always specific."
    },
    "rubric": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "band",
          "note"
        ],
        "properties": {
          "area": {
            "type": "string",
            "enum": [
              "demand",
              "structure",
              "content",
              "evidence",
              "balance",
              "presentation"
