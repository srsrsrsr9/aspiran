            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 45
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 62
              }
            }
          }
        }
      },
      "minItems": 3,
      "maxItems": 3
    },
    "missing": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "en",
          "hi"
        ],
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 10
          },
          "hi": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 14
          }
        }
      },
      "minItems": 0,
      "maxItems": 5,
      "description": "Dimensions or examples a strong answer would add"
    },
    "betterIntro": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 45
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 62
        }
      }
    },
    "betterConclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 45
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 62
        }
      }
    },
    "diagramIdea": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "en",
            "hi"
          ],
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 25
            },
            "hi": {
              "type": "string",
              "minLength": 1,
              "x-maxWords": 34
            }
          }
