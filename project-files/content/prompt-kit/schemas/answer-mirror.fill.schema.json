          },
          "band": {
            "type": "string",
            "enum": [
              "strong",
              "fine",
              "needs-work"
            ]
          },
          "note": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "hi"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 22
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 30
              }
            }
          }
        }
      },
      "minItems": 6,
      "maxItems": 6
