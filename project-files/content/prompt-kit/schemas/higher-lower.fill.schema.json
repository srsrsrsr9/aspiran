          },
          "nugget": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "hi"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 18
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 25
              }
