    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 3
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 4
        }
      }
    },
    "direction": {
