      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 24
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 33
        }
