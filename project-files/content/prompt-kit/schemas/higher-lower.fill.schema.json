            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 5
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 7
              }
            }
          },
          "value": {
            "type": "number"
          },
          "valueLabel": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 4,
