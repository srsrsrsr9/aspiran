{
  "title": "Fact or Fake (swipe cards)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "tone",
    "title",
    "cards",
    "endLine",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 60,
      "description": "lowercase-with-hyphens slug"
    },
    "tone": {
      "type": "string",
      "enum": [
        "LIGHT",
        "NEUTRAL",
        "SERIOUS",
        "TRAGIC"
      ]
    },
    "title": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 8
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 11
        }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "isTrue",
          "trap",
          "statement",
          "reveal"
        ],
        "properties": {
          "isTrue": {
            "type": "boolean"
          },
          "trap": {
            "type": "string",
            "enum": [
              "none",
              "extreme-word",
              "half-true",
              "right-fact-wrong-reason",
              "recent-news-bias",
              "sounds-familiar",
              "wrong-number",
              "swapped-pair"
            ]
          },
          "statement": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "hi"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 18
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 25
              }
            }
          },
          "reveal": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "en",
              "hi"
            ],
            "properties": {
              "en": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 24
              },
              "hi": {
                "type": "string",
                "minLength": 1,
                "x-maxWords": 33
              }
            },
            "description": "If fake: the corrected statement. If true: one extra detail that makes it stick."
          }
        }
      },
      "minItems": 10,
      "maxItems": 12,
      "description": "Between 40% and 60% true. Fakes are the exam's own traps, never silly."
    },
    "endLine": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "hi"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 20
        },
        "hi": {
          "type": "string",
          "minLength": 1,
          "x-maxWords": 28
        }
      },
      "description": "What this deck trained, said like a senior"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "verify"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "x-maxWords": 45
          },
          "verify": {
            "type": "boolean",
            "description": "true until a person has checked it"
          }
        }
      },
      "minItems": 1,
      "maxItems": 6,
      "description": "Never invent a source."
    }
  },
  "x-type": "upsc-pods/swipe@1"
}