# Secrets and signing: never commit these.
*.jks
*.keystore
keystore.properties
local.properties
.dev.vars
.dev.vars.*

# On-device model files are large; fetch them, don't commit them.
server/models/*.litertlm

# Build and tool output
node_modules/
.wrangler/
.wrangler-test/
.wrangler-auth/
android/.gradle/
android/.gsock/
android/build/
android/app/build/
.idea/
*.iml

# Keys and OAuth client files: never commit.
keys/
**/client_secret*.json
android/.kotlin/
android/app/release/
*.apk
*.aab
android/app/google-services.json
.wrangler*/
server/.wrangler-*/
_incoming/
project-files/**/*.mp4
server/models/*.xnnpack_cache
.DS_Store
# project-files is reference only: keep its text in git, its bulky media out
project-files/**/*.wav
project-files/**/*.mp3
project-files/**/*.m4a
project-files/**/*.ogg
project-files/**/*.zip
project-files/**/*.png

# Sarvam recordings (300+ MB): the source zips stay in docs/content, and the import puts them in R2.
content/audio/recordings/**/*.mp3

# Marketing pack: images and the zip are rebuilt by artefacts/marketing-pack-*/_build/build.py
artefacts/marketing-pack-*/**/*.png
artefacts/marketing-pack-*/_build/pylib/
artefacts/marketing-pack-*/_build/html/
artefacts/aspiran-marketing-pack-*.zip
# Trailer (13 Nov 2026): videos, audio takes and frames are large; rebuilt by artefacts/trailer-2026-11-13/build/make.sh
artefacts/trailer-2026-11-13/*.mp4
artefacts/trailer-2026-11-13/_work/
artefacts/trailer-2026-11-13/audio/vo/*.mp3
artefacts/trailer-2026-11-13/audio/sfx/*.mp3
