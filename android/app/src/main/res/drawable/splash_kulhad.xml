<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ splash icon: Chotu's kulhad, the same drawing as ui/Kulhad.kt, scaled 1.5x and centred in the
  288dp canvas (inside the 192dp circle the system keeps), so it lines up with the 96dp kulhad in LaunchWelcome.
  The cup settles in and three wisps of steam rise, about 1 second in all. No text: splash icons can't carry any,
  so the greeting rises in the app right after (ui/Welcome.kt, LaunchWelcome).
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="288"
            android:viewportHeight="288">
            <group android:name="cup" android:pivotX="144" android:pivotY="180">
                <group android:translateX="96" android:translateY="96" android:scaleX="1.5" android:scaleY="1.5">
                    <group android:name="steam">
                        <path android:name="s1" android:pathData="M22,14 q-4,-6 0,-11" android:fillColor="#00000000"
                            android:strokeColor="#B9AA9C" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0" />
                        <path android:name="s2" android:pathData="M32,13 q4,-6 0,-12" android:fillColor="#00000000"
                            android:strokeColor="#B9AA9C" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0" />
                        <path android:name="s3" android:pathData="M42,14 q-4,-6 0,-11" android:fillColor="#00000000"
                            android:strokeColor="#B9AA9C" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0" />
                    </group>
                    <path android:fillColor="#B5562B" android:pathData="M12,20 L52,20 L46,56 Q32,60 18,56 Z" />
                    <path android:fillColor="#9A4321" android:pathData="M12,20 L52,20 L51,25 L13,25 Z" />
                    <path android:fillColor="#7A3418" android:pathData="M12,20 a20,3.2 0 1,0 40,0 a20,3.2 0 1,0 -40,0 Z" />
                    <path android:fillColor="#00000000" android:strokeColor="#CF7448" android:strokeWidth="2" android:strokeLineCap="round"
                        android:strokeAlpha="0.6" android:pathData="M18,30 Q20,44 22,52" />
                    <path android:fillColor="#2A1A10" android:pathData="M23.4,36 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />
                    <path android:fillColor="#2A1A10" android:pathData="M35.4,36 a2.6,2.6 0 1,0 5.2,0 a2.6,2.6 0 1,0 -5.2,0 Z" />
                </group>
            </group>
        </vector>
    </aapt:attr>

    <target android:name="cup">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.88" android:valueTo="1" android:duration="450"
                    android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.88" android:valueTo="1" android:duration="450"
                    android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
    <target android:name="steam">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="translateY" android:valueFrom="6" android:valueTo="-3" android:startOffset="200"
                android:duration="800" android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>
    <target android:name="s1">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="0.8" android:startOffset="250" android:duration="400" />
        </aapt:attr>
    </target>
    <target android:name="s2">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="0.8" android:startOffset="400" android:duration="400" />
        </aapt:attr>
    </target>
    <target android:name="s3">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="strokeAlpha" android:valueFrom="0" android:valueTo="0.8" android:startOffset="550" android:duration="400" />
        </aapt:attr>
    </target>
</animated-vector>
