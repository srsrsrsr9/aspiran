<?xml version="1.0" encoding="utf-8"?>
<!-- The review build: no Focus accessibility service, so Play Protect lets it install from WhatsApp or Drive. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <service android:name=".data.FocusGuard" tools:node="remove" />
    </application>
</manifest>
